{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "highlighted-website",
  "compatibility_date": "2026-06-29",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/books/*"]
  },
  "vars": {
    "PUBLISHED_BOOK_ORIGIN": "https://booklight-api.herokuapp.com"
  }
}
